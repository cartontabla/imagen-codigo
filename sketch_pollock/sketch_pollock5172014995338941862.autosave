// sketch_pollock
// Goteo y trazo, ambos irregulares: el azar solicitado de Jackson Pollock.
// El trazo es un arco tendido, de poco giro; el goteo, una vertical que cae.

color[] paleta = {#141414, #F2EEE2, #A8A8A0, #C02828, #2848A0, #C8A028, #2E7A46, #C87028};
color   fondo  = #D8D0BC;    // el lienzo crudo, sin imprimar

void setup() {
  size(700, 900);
  pixelDensity(1);
  randomSeed(7);             // el azar fijado: el "controlo el flujo" de Pollock
  noLoop();
}

void draw() {
  background(fondo);
  noFill();

  for (int i = 0; i < 260; i++) {
    trazo(paleta[int(random(paleta.length))]);
  }
  for (int i = 0; i < 824; i++) {
    goteo(paleta[int(random(paleta.length))]);
  }
  save("pollock.png");
}

// el trazo: un arco tendido a la horizontal, fino, con latigazo ocasional
void trazo(color c) {
  stroke(c, 190);
  strokeWeight(random(1, 2));
  float x = random(width);
  float y = random(height);
  float a = (random(1) < 0.5 ? 0 : PI) + random(-0.5, 0.5);   // a ras, horizontal
  float v = random(4, 8);              // paso corto: línea fina
  int   n = int(random(120, 280));     // longitud: barre el lienzo
  float giro = random(-0.8, 0.8);      // giro pequeño: arco tendido, no vertical
  float dg = giro / n;                 // giro por paso
  beginShape();
  for (int k = 0; k < n; k++) {
    vertex(x, y);
    a += dg + random(-0.02, 0.02);     // la curva + la irregularidad
    if (random(1) < 0.01) a += random(-1.5, 1.5);   // el latigazo
    x += cos(a) * v;
    y += sin(a) * v;
    if (x < 0 || x > width || y < 0 || y > height) break;
  }
  endShape();
}

// el goteo: una vertical fina que serpentea al caer y termina en gota
void goteo(color c) {
  stroke(c, 150);
  strokeWeight(1);
  float x = random(width);
  float y = random(height);      // empieza en casi cualquier altura
  int   n = int(random(50, 280));      // longitud variable: corto o hasta el suelo
  beginShape();
  for (int k = 0; k < n; k++) {
    vertex(x, y);
    x += random(-1.0, 1.0);            // serpentea
    y += random(2, 5);                 // cae
    if (y > height) break;
  }
  endShape();
  if (random(1) < 0.7 && y < height) { // la gota, solo si no se salió del lienzo
    fill(c, 150);
    noStroke();
    ellipse(x, y, random(3, 8), random(4, 12));
  }
}
