// sketch_pollock
// Goteo y trazo, ambos irregulares: el azar solicitado de Jackson Pollock.
// El trazo es un arco que barre y a veces se cierra en bucle; el goteo cae.

color[] paleta = {#181818, #E8E4DA, #A9A9A0, #8A4A3A, #3A4A5A};
color   fondo  = #DED6C4;    // el lienzo crudo, sin imprimar

void setup() {
  size(700, 900);
  pixelDensity(1);
  randomSeed(10);             // el azar fijado: el "controlo el flujo" de Pollock
  noLoop();
}

void draw() {
  background(fondo);
  noFill();

  for (int i = 0; i < 470; i++) {
    trazo(paleta[int(random(paleta.length))]);
  }
  for (int i = 0; i < 835; i++) {
    goteo(paleta[int(random(paleta.length))]);
  }
  save("pollock.png");
}

// el trazo: un arco que barre con inercia; a veces se cierra en bucle
void trazo(color c) {
  stroke(c, 150);
  strokeWeight(random(1, 3));
  float x = random(width);
  float y = random(height);
  float a = random(TWO_PI);            // dirección inicial
  float v = random(4, 9);              // paso
  int   n = int(random(120, 380));     // longitud del arco
  float giro = random(-6, 6);      // giro total: de arco abierto a bucle
  float dg = giro / n;                 // giro por paso
  beginShape();
  for (int k = 0; k < n; k++) {
    vertex(x, y);
    a += dg + random(-0.03, 0.03);     // la curva + la irregularidad
    if (random(1) < 0.015) a += random(-2.2, 2.2);   // el latigazo
    x += cos(a) * v;
    y += sin(a) * v;
    if (x < 0 || x > width || y < 0 || y > height) break;
  }
  endShape();
}

// el goteo: una vertical que serpentea al caer y termina en gota
void goteo(color c) {
  stroke(c, 150);
  strokeWeight(random(1, 2));
  float x = random(width);
  float y = random(height);
  beginShape();
  for (int k = 0; k < 50; k++) {
    vertex(x, y);
    x += random(-1.0, 1.0);            // serpentea
    y += random(2, 10);                 // cae
    if (y > height) break;
  }
  endShape();
  if (random(1) < 0.6) {               // la gota que se detiene
    fill(c, 150);
    noStroke();
    ellipse(x, y, random(3, 8), random(4, 11));
  }
}
